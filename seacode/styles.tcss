Screen {
    background: #15191b;
    color: #d9e2e3;
}

#title-bar {
    dock: top;
    width: 100%;
    height: 3;
    padding: 0 1;
}

#provider-select {
    align: center middle;
    width: 100%;
    height: 1fr;
}

#select-label {
    width: 100%;
    text-align: center;
    height: auto;
    margin-top: 2;
    text-style: bold;
}

#provider-list {
    width: 60;
    height: auto;
    max-height: 16;
    margin: 1 2;
}

#chat-area {
    height: 1fr;
    min-height: 18;
    padding: 0 1;
}

.message {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0 2;
}

.user-message {
    color: #f2f5f5;
}

.assistant-message,
.assistant-markdown {
    color: #d9e2e3;
}

.thinking-message {
    color: #aebbc0;
    text-style: italic;
}

.error-message {
    color: #ff9c9c;
}

#input-area {
    dock: bottom;
    height: auto;
    max-height: 20;
    padding: 0 1;
    border-top: solid #303030;
}

#chat-input {
    height: auto;
    min-height: 1;
    max-height: 10;
    border: none;
}

#status-bar {
    height: auto;
    min-height: 1;
    width: 100%;
    padding: 0 1;
    border-top: solid #303030;
}

#turn-status {
    width: 1fr;
    height: 1;
    color: #aebbc0;
    padding: 0 1;
}

#model-label {
    width: auto;
    height: 1;
    text-align: right;
    color: #aebbc0;
    padding: 0 1;
}
