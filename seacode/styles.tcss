Screen {
    background: #15191b;
    color: #d9e2e3;
}

#title-bar {
    dock: top;
    width: 100%;
    height: 3;
    padding: 0 1;
}

#provider-select {
    align: center middle;
    width: 100%;
    height: 1fr;
}

#select-label {
    width: 100%;
    text-align: center;
    height: auto;
    margin-top: 2;
    text-style: bold;
}

#provider-list {
    width: 60;
    height: auto;
    max-height: 16;
    margin: 1 2;
}

#chat-area {
    height: 1fr;
    min-height: 18;
    padding: 0 1;
}

.message {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0 2;
}

.user-row {
    height: auto;
    width: 100%;
}

.user-message {
    color: #f2f5f5;
}

.ai-row {
    height: auto;
    width: 100%;
}

.assistant-message,
.assistant-markdown {
    color: #d9e2e3;
}

.thinking-message {
    color: #aebbc0;
    text-style: italic;
}

.error-message {
    color: #ff9c9c;
}

/* thinking 期间持续旋转的 spinner 标签，固定单行高度避免撑开聊天区。 */
#spinner-live {
    height: 1;
    padding: 0 2;
}

#perm-inline {
    height: auto;
    padding: 0 0;
    margin: 0 0;
}

#perm-content {
    padding: 0 0;
}

#plan-inline {
    height: auto;
    padding: 0 0;
    margin: 0 0;
}

#plan-content {
    padding: 0 0;
}

.tool-block-loading {
    color: #d9a441;
}

.tool-block-error {
    color: #ff9c9c;
}

.thinking-done {
    color: #d9a441;
    text-style: italic;
}

.system-message {
    color: #8a9a9e;
    text-style: italic;
}

#input-area {
    dock: bottom;
    height: auto;
    max-height: 20;
    padding: 0 1;
    border-top: solid #303030;
}

#chat-input {
    height: auto;
    min-height: 1;
    max-height: 10;
    border: none;
}

#status-bar {
    height: auto;
    min-height: 1;
    width: 100%;
    padding: 0 1;
    border-top: solid #303030;
}

#turn-status {
    width: 1fr;
    height: 1;
    color: #aebbc0;
    padding: 0 1;
}

#model-label {
    width: auto;
    height: 1;
    text-align: right;
    color: #aebbc0;
    padding: 0 1;
}

#mode-label {
    width: auto;
    height: 1;
    text-align: right;
    padding: 0 1;
}

/* batch08：会话恢复内联视图 */
#resume-inline {
    width: 100%;
    height: auto;
    max-height: 24;
    margin: 1 0;
    padding: 1 2;
    border: solid #303030;
    background: #1a1f22;
}

#resume-content {
    width: 100%;
    height: auto;
}
