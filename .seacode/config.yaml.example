# Copy this file to .seacode/config.local.yaml in a project directory.
providers:
  - name: primary
    protocol: openai-compat
    model: your-model-name
    base_url: https://api.example.com
    api_key: replace-with-your-key
    thinking: false

# OS 级沙箱配置（可选）；enabled 开启内核隔离，auto_allow 联动权限 Layer 1c 自动放行。
# 仅 macOS（seatbelt）与 Linux（bubblewrap）支持；Windows 自动降级为应用层路径检查。
sandbox:
  enabled: false
  auto_allow: false
  network_enabled: false

# MCP 外部工具服务器配置（可选）；command 走 stdio 子进程，url 走 Streamable HTTP。
# env 中的 ${VAR} 在连接时展开为环境变量；headers 中的 ${VAR} 同样展开（用于鉴权令牌）。
# 同名服务器在多层配置中按后层覆盖前层合并；单服务器失败不阻断其它服务器与主流程。
mcp_servers:
  # stdio 子进程示例：通过 npx 启动一个 MCP 服务器
  - name: filesystem
    command: npx
    args:
      - "-y"
      - "@modelcontextprotocol/server-filesystem"
      - "/path/to/allowed/dir"
    env:
      NODE_PATH: "${NODE_PATH}"
  # Streamable HTTP 示例：连接远端 MCP 服务器
  # - name: remote
  #   url: https://mcp.example.com/sse
  #   headers:
  #     Authorization: "Bearer ${MCP_TOKEN}"

# 生命周期 Hook 配置（可选）；三层配置叠加合并，用户级 + 项目级 + 本地级 Hook 全部累加。
# event 取值见 LifecycleEvent；action.type 支持 command/prompt/http/agent 四类。
# reject 仅 pre_tool_use 可用；async 仅非 pre_tool_use 可用；once 控制单次执行。
# if 条件支持 ==/!=/=~/~= 四操作符与 &&/|| 组合（不可混用）。
hooks:
  # 拦截写 JSON 文件：pre_tool_use + reject + if 条件匹配 WriteFile 且 file_path 以 .json 结尾
  - id: block-json-write
    event: pre_tool_use
    if: 'tool == "WriteFile" && args.file_path =~ "/\\.json$/"'
    reject: true
    action:
      type: prompt
      message: "禁止写入 JSON 文件：$TOOL_ARGS.file_path"
  # 会话开始时注入提示词：session_start + once 确保只执行一次
  - id: session-start-read-arch
    event: session_start
    once: true
    action:
      type: prompt
      message: "会话开始，请阅读 ARCHITECTURE.md 了解项目结构。"
